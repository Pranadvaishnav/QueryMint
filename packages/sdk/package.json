{
  "name": "@querymint/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Buyer SDK for QueryMint quotes, Whitechain settlement, and authorized data delivery.",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && npm run build --workspace @querymint/shared && tsc -p tsconfig.build.json",
    "test": "npm run build && tsx --test test/sdk.test.ts",
    "typecheck": "npm run build --workspace @querymint/shared && tsc --noEmit -p tsconfig.json",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@querymint/shared": "0.1.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
