# Whitechain Sepolia (chain 1874)
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# Arkiv Rabdi (chain 7794095). The coordinator consumes this server-side via rabdi({ accessKey }).
# Do not add a VITE_ prefix. Empty uses the heavily rate-limited public endpoint.
# Create a site-locked key at https://hub.arkiv.network/access-keys for reliable use.
ARKIV_ACCESS_KEY=
ARKIV_INDEXER_URL=https://indexer.rabdi.db-chain.testnet.arkiv.network
PUBLISHER_A_PRIVATE_KEY=
PUBLISHER_B_PRIVATE_KEY=

# Coordinator signing key: local development only. Never commit a real key.
COORDINATOR_PRIVATE_KEY=
COORDINATOR_ADDRESS=
DEMO_ENCRYPTION_KEY=

# Contract address after deployment
QUERYMINT_SETTLEMENT_ADDRESS=
QUERYMINT_DEPLOYMENT_BLOCK=
DEPLOYER_PRIVATE_KEY=
WHITECHAIN_EXPLORER_API_KEY=
QUOTE_TTL_SECONDS=300

# API/UI
COORDINATOR_PORT=3001
# Local development origins. In production configure exact HTTPS origins, comma-separated.
COORDINATOR_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY_HOPS=0
COORDINATOR_RATE_LIMIT_PER_MINUTE=60
VITE_COORDINATOR_API_URL=http://localhost:3001
VITE_QUERYMINT_SETTLEMENT_ADDRESS=
VITE_COORDINATOR_ADDRESS=
VITE_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
VITE_ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
