{
  "name": "querymint",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:contracts": "node node_modules/@foundry-rs/forge/bin.mjs test --root packages/contracts -vvv",
    "test:coordinator": "npm run test --workspace @querymint/coordinator",
    "dev:coordinator": "npm run dev --workspace @querymint/coordinator",
    "dev:web": "npm run dev --workspace @querymint/web",
    "dev:demo": "npm run dev --workspace @querymint/demo",
    "snapshot:gas": "node node_modules/@foundry-rs/forge/bin.mjs snapshot --root packages/contracts --snap packages/contracts/.gas-snapshot"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
